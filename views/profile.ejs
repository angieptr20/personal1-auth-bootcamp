<!doctype html>
<html>
<head>
    <title>The Flag Game</title>
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/bootstrap/3.0.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/font-awesome/4.0.3/css/font-awesome.min.css">
    <link rel="stylesheet" href="style.css">
</head>
<body>
<div class="container">

    <div class="page-header text-center">
        <h1><span class="fa fa-anchor"></span> Profile Page</h1>
        <a href="/logout" class="btn btn-default btn-sm">Logout</a>
    </div>

    <div class="row">

        <!-- LOCAL INFORMATION -->
        <div class="col-sm-6">
            <div class="well">
                <h3><span class="fa fa-user"></span> Local</h3>

                <% if (user.local.email) { %>
                    <p>
                        <strong>id</strong>: <%= user._id %><br>
                        <strong>email</strong>: <p id="user-email"><%= user.local.email %></p><br>
                        <strong>password</strong>: <%= user.local.password %>
                    </p>

                    <a href="/unlink/local" class="btn btn-default">Unlink</a>
                <% } else { %>
                    <a href="/connect/local" class="btn btn-default">Connect Local</a>
                <% } %>

            </div>
        </div>
        <div class="col-sm-6">

        <h3>Points: </h3>
        <span class="points"><%= scores[0].score%></span> <!-- Displays score from MongoDB -->

        <h2>Which country has this flag?</h2>
        <img src="img/south-africa.jpeg" alt="secret flag">
        <form>
          <label>
            <input type="radio" name="choice" value="congo">The Republic of the Congo
          </label>
          <label>
              <input type="radio" name="choice" value="netherlands">The Netherlands
          </label>
          <label>
            <input type="radio" name="choice" value="south-africa" id="south-africa">South Africa
          </label>
          <label>
            <input type="radio" name="choice" value="guatemala">Guatemala
          </label>
          <button id="quizForm" type="submit">Submit</button>
        </form>

        <h2>What is the capital city?</h2>

        <form action="/submit-capital" method="POST"> <!-- Sends answer using POST -->
            <input type="hidden" name="username" value="<%= user.local.email %>"> <!-- Stores username -->
            <input type="text" name="capital" placeholder="Enter the capital city">
            <button type="submit">Submit</button>
        </form>
        
        <h3>Submitted Answers:</h3>
        <ul class="messages">
            <% capitals.forEach(entry => { %>
                <li class="message">
                    <span><%= entry.capital %></span>
                    <button class="delete-btn" data-username="<%= entry.username %>" data-capital="<%= entry.capital %>">Delete</button>
                </li>
            <% }); %>
        </ul>
      </div>

<script src="main.js"></script>

</body>
</html>
